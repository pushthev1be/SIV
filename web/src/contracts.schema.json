        "goal_event": {
          "anyOf": [
            {
              "pattern": "^m\\d{2}-e\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "incident_id": {
          "pattern": "^inc-m\\d{2}-\\d+$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "offside",
            "foul",
            "penalty",
            "handball",
            "red_card",
            "goal_check"
          ],
          "type": "string"
        },
        "on_field": {
          "type": "string"
        },
        "opened_at": {
          "minimum": 0.0,
          "type": "number"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "enum": [
              "tight_margin",
              "subjective_interference",
              "obstructed_view",
              "multiple_phases",
              "earlier_offence",
              "subjective_judgement"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "state": {
          "enum": [
            "open",
            "reviewing",
            "decided",
            "restarted"
          ],
          "type": "string"
        },
        "var_outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "incident_id",
        "kind",
        "state",
        "on_field",
        "opened_at"
      ],
      "title": "Incident",
      "type": "object"
    },
