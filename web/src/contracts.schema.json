          "default": null
        },
        "positions": {
          "patternProperties": {
            "^[A-Z]{3}-\\d{1,2}$": {
              "additionalItems": false,
              "items": [
                {
                  "maximum": 110.0,
                  "minimum": -5.0,
                  "type": "number"
