                {
                  "maximum": 73.0,
                  "minimum": -5.0,
                  "type": "number"
                }
              ],
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            }
          },
          "type": "object"
        },
        "receiver": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}-\\d{1,2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "start": {
          "anyOf": [
            {
              "additionalItems": false,
