{
  "$defs": {
    "AudienceProfile": {
      "additionalProperties": false,
      "properties": {
        "club": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "focus": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}-\\d{1,2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lang": {
          "default": "en",
          "enum": [
            "en",
            "es"
          ],
          "type": "string"
        },
        "persona": {
          "default": "casual",
          "enum": [
            "casual",
            "analyst",
            "ref_nerd"
          ],
          "type": "string"
        },
        "pin": {
          "anyOf": [
            {
              "enum": [
                "sprint_speed",
                "distance",
                "pass_difficulty",
                "possession",
                "pressure"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "AudienceProfile",
      "type": "object"
    },
    "BallSample": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "minimum": 0.0,
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "default": 0.0,
          "type": "number"
        }
      },
      "required": [
        "t",
        "x",
        "y"
      ],
      "title": "BallSample",
      "type": "object"
    },
    "Band": {
      "additionalProperties": false,
      "properties": {
        "tag": {
          "maxLength": 24,
          "type": "string"
        },
        "text": {
          "maxLength": 140,
          "type": "string"
        }
      },
      "required": [
        "tag",
        "text"
      ],
      "title": "Band",
      "type": "object"
    },
    "BodyFrame": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "patternProperties": {
            "^[A-Z]{3}-\\d{1,2}$": {
              "additionalProperties": {
                "additionalItems": false,
                "items": [
                  {
                    "maximum": 110.0,
                    "minimum": -5.0,
                    "type": "number"
                  },
                  {
                    "maximum": 73.0,
                    "minimum": -5.0,
                    "type": "number"
                  }
                ],
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "propertyNames": {
                "enum": [
                  "head",
                  "torso",
                  "foot_l",
                  "foot_r",
                  "knee_l",
                  "knee_r",
                  "arm"
                ]
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "clock": {
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "clock",
        "body"
      ],
      "title": "BodyFrame",
      "type": "object"
    },
    "Incident": {
      "additionalProperties": false,
      "properties": {
        "decided_at": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "facts": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "default": {},
          "type": "object"
        },
        "final": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
