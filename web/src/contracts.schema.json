                {
                  "maximum": 110.0,
                  "minimum": -5.0,
                  "type": "number"
                },
                {
                  "maximum": 73.0,
                  "minimum": -5.0,
                  "type": "number"
                }
              ],
              "maxItems": 2,
              "minItems": 2,
